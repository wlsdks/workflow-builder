  "peerDependencies": {
    "@workflow/graph-core": "*"
  },
  "peerDependenciesMeta": {
    "@workflow/graph-core": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "//dependencies": "★ 런타임 의존성 0. graph-core도 값으로 import 하지 않는다 — 입력 타입을 구조적으로만 받는다."
}
